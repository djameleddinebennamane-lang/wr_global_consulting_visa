
<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1426">
<title>WR Global Consulting Visa</title>
<style>
:root {
  --navy:#0b1426;
  --gold:#c9ad78;
  --light:#f1e8d8;
  --muted:#aeb8c7;
}
* {box-sizing:border-box}
body {
  margin:0;
  min-height:100vh;
  background:radial-gradient(ellipse at 50% 42%,#1b2c46 0%,#101d32 48%,#080f1d 100%);
  color:var(--light);
  font-family:Georgia,"Times New Roman",serif;
}
header {
  height:82px;
  padding:0 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-bottom:1px solid #c9ad783b;
}
.brand {color:var(--gold);font-size:25px;letter-spacing:4px}
.brand small {
  display:block;
  font:10px Arial,sans-serif;
  letter-spacing:3px;
  margin-top:5px;
}
button {
  cursor:pointer;
  font:inherit;
}
.lang {
  background:transparent;
  color:var(--gold);
  border:1px solid var(--gold);
  border-radius:20px;
  padding:9px 17px;
}
main {
  min-height:calc(100vh - 82px);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:24px 5%;
  text-align:center;
}
.eyebrow {
  color:var(--gold);
  font:11px Arial,sans-serif;
  letter-spacing:4px;
  margin:0 0 15px;
}
h1 {
  font-size:clamp(25px,4vw,43px);
  font-weight:normal;
  letter-spacing:2px;
  margin:0;
}
.subtitle {
  color:var(--muted);
  font:12px Arial,sans-serif;
  letter-spacing:2px;
  margin:13px 0 20px;
}
.globe {
  width:clamp(145px,23vh,210px);
  height:clamp(145px,23vh,210px);
  margin:8px auto 24px;
  border:1px solid var(--gold);
  border-radius:50%;
  position:relative;
  display:grid;
  place-items:center;
  box-shadow:0 0 35px #c9ad7824,inset 0 0 30px #c9ad7818;
}
.globe:before,.globe:after {
  content:"";
  position:absolute;
  border:1px solid #c9ad7870;
  border-radius:50%;
}
.globe:before {width:48%;height:100%}
.globe:after {width:100%;height:48%}
.globe svg {width:65%;height:65%;color:var(--gold)}
.menu {
  width:min(680px,100%);
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}
.menu button {
  min-height:65px;
  background:#ffffff08;
  border:1px solid #c9ad7870;
  color:var(--light);
  padding:12px 5px;
  font-size:15px;
  transition:.2s;
}
.menu button:hover {
  background:#c9ad7820;
  border-color:var(--gold);
  color:var(--gold);
}
footer {
  color:#9da8b8;
  font:10px Arial,sans-serif;
  letter-spacing:2px;
  margin-top:25px;
}
.panel {
  display:none;
  width:min(650px,100%);
  padding:35px 25px;
  border:1px solid #c9ad7870;
  background:#101d32eF;
}
.panel h2 {color:var(--gold);font-weight:normal}
.panel p {color:var(--muted);line-height:1.8}
.back {
  background:transparent;
  border:1px solid var(--gold);
  color:var(--gold);
  padding:10px 24px;
  margin-top:20px;
}
[dir="rtl"] {font-family:Tahoma,Arial,sans-serif}
[dir="rtl"] .brand {letter-spacing:1px}
[dir="rtl"] .eyebrow,[dir="rtl"] .subtitle {letter-spacing:1px}
@media(max-width:500px) {
  header {height:70px;padding:0 5%}
  .brand {font-size:20px;letter-spacing:2px}
  main {padding:20px 5%}
  .menu {grid-template-columns:repeat(2,1fr);gap:9px}
  .menu button {font-size:14px;min-height:59px}
}
</style>
</head>
<body>
<header>
  <div class="brand">
    WR GLOBAL
    <small>CONSULTING VISA</small>
  </div>
  <button class="lang" id="language">العربية</button>
</header>

<main>
  <section id="home">
    <p class="eyebrow" id="eyebrow">INTERNATIONAL BUSINESS & CONSULTING</p>
    <h1 id="heading">A WORLD OF OPPORTUNITIES</h1>
    <p class="subtitle" id="subtitle">EXPERTISE · GUIDANCE · INTERNATIONAL VISION</p>

    <div class="globe">
      <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="50" cy="50" r="45"/>
        <path d="M5 50h90M50 5v90M15 25h70M15 75h70"/>
        <path d="M50 5c-25 20-25 70 0 90M50 5c25 20 25 70 0 90"/>
        <path d="M17 17l66 66M83 17L17 83" opacity=".45"/>
      </svg>
    </div>

    <nav class="menu" id="menu">
      <button data-page="about">Présentation</button>
      <button data-page="activities">Nos activités</button>
      <button data-page="services">Nos services</button>
      <button data-page="destinations">Destinations</button>
      <button data-page="advice">Espace conseil</button>
      <button data-page="contact">Contact</button>
    </nav>
    <footer id="footer">WR GLOBAL CONSULTING VISA · INTERNATIONAL</footer>
  </section>

  <section class="panel" id="panel">
    <p class="eyebrow" id="panel-label">WR GLOBAL CONSULTING VISA</p>
    <h2 id="panel-title"></h2>
    <p id="panel-text"></p>
    <button class="back" id="back">Retour à l'accueil</button>
  </section>
</main>

<script>
const translations = {
 fr:{
  toggle:"العربية",
  eyebrow:"INTERNATIONAL BUSINESS & CONSULTING",
  heading:"UN MONDE D'OPPORTUNITÉS",
  subtitle:"EXPERTISE · CONSEIL · VISION INTERNATIONALE",
  menu:["Présentation","Nos activités","Nos services","Destinations","Espace conseil","Contact"],
  back:"Retour à l'accueil",
  pages:[
   ["Présentation","WR Global Consulting Visa est un bureau d'affaires et de conseil tourné vers l'international."],
   ["Nos activités","Découvrez les domaines d'activité et les perspectives de notre bureau."],
   ["Nos services","Un accompagnement professionnel adapté à vos besoins et à vos projets."],
   ["Destinations","Explorez les destinations et les possibilités d'accompagnement international."],
   ["Espace conseil","Un espace dédié à l'information, à l'orientation et au conseil."],
   ["Contact","Retrouvez prochainement nos coordonnées et nos moyens de contact."]
  ]
 },
 ar:{
  toggle:"Français",
  eyebrow:"الأعمال والاستشارات الدولية",
  heading:"عالم من الفرص",
  subtitle:"الخبرة · الاستشارة · الرؤية الدولية",
  menu:["من نحن","أنشطتنا","خدماتنا","الوجهات","فضاء الاستشارة","اتصل بنا"],
  back:"العودة إلى الرئيسية",
  pages:[
   ["من نحن","WR Global Consulting Visa مكتب أعمال واستشارات ذو توجه دولي."],
   ["أنشطتنا","اكتشف مجالات عمل المكتب وآفاقه."],
   ["خدماتنا","مرافقة مهنية تتناسب مع احتياجاتكم ومشاريعكم."],
   ["الوجهات","اكتشف الوجهات وفرص المرافقة الدولية."],
   ["فضاء الاستشارة","فضاء مخصص للمعلومات والتوجيه والاستشارات."],
   ["اتصل بنا","ستجدون قريباً معلومات الاتصال ووسائل التواصل معنا."]
  ]
 }
};
let lang="fr";
const home=document.getElementById("home");
const panel=document.getElementById("panel");

function render(){
 const t=translations[lang];
 document.documentElement.lang=lang;
 document.documentElement.dir=lang==="ar"?"rtl":"ltr";
 document.getElementById("language").textContent=t.toggle;
 document.getElementById("eyebrow").textContent=t.eyebrow;
 document.getElementById("heading").textContent=t.heading;
 document.getElementById("subtitle").textContent=t.subtitle;
 document.getElementById("back").textContent=t.back;
 [...document.querySelectorAll("#menu button")].forEach((b,i)=>{
  b.textContent=t.menu[i];
 });
}
document.getElementById("language").onclick=()=>{
 lang=lang==="fr"?"ar":"fr";
 render();
};
document.querySelectorAll("#menu button").forEach((b,i)=>{
 b.onclick=()=>{
  const p=translations[lang].pages[i];
  home.style.display="none";
  panel.style.display="block";
  document.getElementById("panel-title").textContent=p[0];
  document.getElementById("panel-text").textContent=p[1];
 };
});
document.getElementById("back").onclick=()=>{
 panel.style.display="none";
 home.style.display="block";
};
render();
</script>
</body>
</html>
